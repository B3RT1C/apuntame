# Apuntame Docker Configuration
# IMPORTANT: Replace all CHANGE_ME values with your own secure credentials

# PostgreSQL Database Configuration
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=apuntame

# Backend Database Connection (must match PostgreSQL values above)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=apuntame
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# Demo Data Configuration
# Set to "true" to load demo data on first run, "false" to start with empty database
INITIALIZE_DEMO_DATA=false

# Spring Profile (do not change)
SPRING_PROFILES_ACTIVE=prod
