# Plantilla de variables para docker-compose.test.yml
# Copia a .env y ajusta valores: cp .env.example .env

# PostgreSQL
POSTGRES_USER=apuntame_test
POSTGRES_PASSWORD=apuntame_test_pass
POSTGRES_DB=apuntame

# Backend (deben coincidir con PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=apuntame
DB_USER=apuntame_test
DB_PASSWORD=apuntame_test_pass

# JWT: clave Base64 de 256 bits (32 bytes). Obligatoria para el perfil test.
# Generar una nueva: openssl rand -base64 32
JWT_SECRET=YXB1bnRhbWUtdGVzdC1qd3Qtc2VjcmV0LWtleS0zMmIh

# Demo data (usuarios admin/admin, camarero1/camarero1, menú de ejemplo)
INITIALIZE_DEMO_DATA=true
